# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=customiseclothing.in,www.customiseclothing.in

# PostgreSQL (or single DATABASE_URL on PaaS like Railway/Render):
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_ENGINE=django.db.backends.postgresql
DB_NAME=customise_clothing
DB_USER=customise_user
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Razorpay (leave empty to disable online payments — COD only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CORS & CSRF Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://customiseclothing.in,https://customiseclothing.in
CSRF_TRUSTED_ORIGINS=http://customiseclothing.in,https://customiseclothing.in

# Company / Branding
COMPANY_NAME=Customise Clothing
COMPANY_LOGO=https://customiseclothing.in/static/images/logo.png
COMPANY_THEME_COLOR=#6366f1
CONTACT_PHONE=+91 9114960778
CONTACT_EMAIL=customiseclothingofficial@gmail.com
CONTACT_SUPPORT_EMAIL=help@customiseclothing.in

# Delivery Config
FREE_DELIVERY_THRESHOLD=349.00
DELIVERY_CHARGE=25.00
ORDER_DELIVERY_DAYS=5

# Fallback Images
DEFAULT_PRODUCT_FALLBACK_IMAGE=https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=400&q=80
DEFAULT_CATEGORY_FALLBACK_IMAGE=https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=150&h=150&fit=crop

# Email (SMTP for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Customise Clothing <noreply@customiseclothing.com>
ADMIN_EMAIL=admin@customiseclothing.com
